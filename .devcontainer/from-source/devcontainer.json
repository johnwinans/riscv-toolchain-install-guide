{
    "name": "RISC-V Dev (from source)",
    "build": {
        "dockerfile": "../../Dockerfile.dev",
        "context": "../..",
        "args": {
            "BASE": "riscv-src"
        }
    },
    "remoteUser": "user",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.cpptools",
                "ms-vscode.cpptools-themes",
                "ms-vscode.hexeditor"
            ],
            "settings": {
                "terminal.integrated.defaultProfile.linux": "bash",
                "C_Cpp.default.compilerPath": "/opt/riscv/bin/riscv64-unknown-elf-gcc",
                "C_Cpp.default.intelliSenseMode": "gcc-arm"
            }
        }
    }
}
